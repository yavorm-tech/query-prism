# Copy to .env and fill in. Required values have no default; the stack refuses to start without them.

# ── Datastores (required) ───────────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=ragdb
NEO4J_PASSWORD=

# ── Security (required) ────────────────────────────────
# openssl rand -hex 32   (at least 32 characters)
SECRET_KEY=

# ── AI providers ───────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# ── App ────────────────────────────────────────────────
API_ENV=production
LOG_LEVEL=info
APP_NAME=QueryPrism
APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
VITE_API_URL=
# Extra browser origins allowed to call the API (comma-separated). Empty = APP_URL + FRONTEND_URL.
CORS_ORIGINS=

# ── Sessions ───────────────────────────────────────────
# Access JWTs are short-lived; the refresh token lives in an httpOnly cookie (path /auth).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Unset: the cookie is Secure when FRONTEND_URL is https. Override with:
# REFRESH_COOKIE_SECURE=true

# ── Google OAuth (optional) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://your-domain.example/auth/oauth/google/callback

# ── Email (Postfix relay) ──────────────────────────────
SMTP_RELAY_HOST_URL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.example
SALES_EMAIL=

# Where the monitoring profile (docker compose --profile monitoring) sends alerts
ALERT_EMAIL=

# ── Backups (optional, procedures/backup.sh) ───────────
# BACKUP_S3_URI=s3://bucket/queryprism
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# ── Upload storage ─────────────────────────────────────
# local: files wait on the shared "uploads" volume (api + worker on one host).
# s3: any S3-compatible bucket, so api and worker can run on different hosts.
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=uploads
# S3_ENDPOINT_URL: empty for AWS; the endpoint of any S3-compatible store otherwise
# (Cloudflare R2, Backblaze B2, a self-hosted Garage/SeaweedFS, ...)
S3_ENDPOINT_URL=
S3_REGION=
# Keys: leave empty on AWS to use the default credential chain (instance role)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Answer tiers ───────────────────────────────────────
# Plans map to a tier; each tier is an ordered provider:model list tried in turn.
# LLM_TIER_BASIC=openai:gpt-4o-mini,anthropic:claude-haiku-4-5-20251001
# LLM_TIER_STANDARD=anthropic:claude-haiku-4-5-20251001,openai:gpt-4o-mini
# LLM_TIER_PREMIUM=anthropic:claude-sonnet-4-6,openai:gpt-4o
