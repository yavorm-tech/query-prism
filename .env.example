# Copy to .env and fill in. Required values have no default; the stack refuses to start without them.

# ── Datastores (required) ───────────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=ragdb
NEO4J_PASSWORD=

# ── Security (required) ────────────────────────────────
# openssl rand -hex 32   (at least 32 characters)
SECRET_KEY=

# ── AI providers ───────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# ── App ────────────────────────────────────────────────
API_ENV=production
LOG_LEVEL=info
APP_NAME=QueryPrism
APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
VITE_API_URL=

# ── Google OAuth (optional) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://your-domain.example/auth/oauth/google/callback

# ── Email (Postfix relay) ──────────────────────────────
SMTP_RELAY_HOST_URL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.example
SALES_EMAIL=

# ── Backups (optional, procedures/backup.sh) ───────────
# BACKUP_S3_URI=s3://bucket/queryprism
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
