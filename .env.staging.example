# Staging settings: copy to .env.staging and fill in. Used only by
# procedures/staging.sh (docker-compose.staging.yml); production's .env is never read.
# Use separate secrets from production everywhere.

# ── Datastores (required; staging has its own volumes) ─
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=ragdb_staging
NEO4J_PASSWORD=
# api and worker connect as this role (created by the migrate service; row-level
# security applies to it). Migrations connect as POSTGRES_USER.
APP_DB_USER=qp_app
APP_DB_PASSWORD=

# ── Security (required; NOT production's key) ──────────
# openssl rand -hex 32
SECRET_KEY=
# Every user's password after "staging.sh refresh" (12+ characters)
STAGING_PASSWORD=

# ── Where staging listens (127.0.0.1 only) ─────────────
STAGING_HTTP_PORT=18080
STAGING_API_PORT=18000

# ── AI providers (separate keys make staging spend visible) ─
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# ── App ────────────────────────────────────────────────
API_ENV=staging
LOG_LEVEL=info
APP_NAME=QueryPrism (staging)
# The address testers open (an SSH tunnel to STAGING_HTTP_PORT, or your proxy)
APP_URL=http://localhost:18080
FRONTEND_URL=http://localhost:18080
VITE_API_URL=
CORS_ORIGINS=

# ── Email ──────────────────────────────────────────────
# Leave the relay empty so staging cannot email anyone; refreshed data uses
# @staging.invalid addresses anyway.
SMTP_RELAY_HOST_URL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@staging.invalid

# ── Upload storage ─────────────────────────────────────
STORAGE_BACKEND=local

# ── Answer tiers: e.g. cheaper models in staging ───────
# LLM_TIER_BASIC=openai:gpt-4o-mini
# LLM_TIER_STANDARD=openai:gpt-4o-mini
# LLM_TIER_PREMIUM=openai:gpt-4o-mini
